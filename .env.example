# GitHub MCP connector configuration.
# Copy to ".env" and fill in, or set these directly in your MCP client's env block.

# Required: a GitHub token used for all API calls.
# The connector adds no repository restrictions of its own; the token's scope
# decides what it can reach.
#   - Access to ALL your repos: classic PAT with the "repo" scope, or a
#     fine-grained PAT with Repository access = "All repositories".
#   - Only specific repos: fine-grained PAT limited to those repositories.
# (GITHUB_PERSONAL_ACCESS_TOKEN and GH_TOKEN are also accepted.)
GITHUB_TOKEN=ghp_your_token_here

# Optional: point at a GitHub Enterprise Server API root.
# Default: https://api.github.com
# Example: https://github.your-company.com/api/v3
GITHUB_API_URL=https://api.github.com

# Optional: disable every write tool (creating/merging PRs, editing issues,
# committing files, managing secrets, deleting releases, and so on).
# Set to "true" to run the connector strictly read-only. Default: false
GITHUB_MCP_READ_ONLY=false

# Optional: HTTP request timeout in seconds. Default: 30
GITHUB_MCP_TIMEOUT=30

# Optional: User-Agent header sent with requests. Default: github-mcp-connector
GITHUB_MCP_USER_AGENT=github-mcp-connector
